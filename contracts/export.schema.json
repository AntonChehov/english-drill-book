{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:english-drill-book:schema:export:1",
  "title": "English Drill Book progress export, format 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "formatVersion", "exportedAt", "attempts", "days"],
  "properties": {
    "kind": { "const": "export" },
    "formatVersion": { "const": 1 },
    "exportedAt": { "$ref": "#/$defs/instant" },
    "appVersion": { "type": "string", "maxLength": 32 },
    "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
    "days": {
      "type": "object",
      "description": "Calendar day (YYYY-MM-DD, device time zone) -> ids of ticked daily blocks.",
      "propertyNames": { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/localId" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": { "enum": ["system", "light", "dark"] },
        "activeProgram": { "$ref": "#/$defs/slug" },
        "focusTopic": { "$ref": "#/$defs/localId" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "localId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 32 },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "UTC, ISO 8601."
    },
    "verdict": { "enum": ["ok", "near", "bad"] },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "pack", "packVersion", "exercise", "action", "answers", "results", "complete"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "UUID; the merge key for import and future sync."
        },
        "at": { "$ref": "#/$defs/instant" },
        "pack": { "$ref": "#/$defs/slug" },
        "packVersion": { "$ref": "#/$defs/semver" },
        "exercise": { "$ref": "#/$defs/localId" },
        "action": { "enum": ["check", "override", "reveal", "mark-done", "dismiss-mistake"] },
        "answers": {
          "type": "object",
          "description": "Item id -> answer as typed. Text and open exercises use the single key \"text\".",
          "additionalProperties": { "type": "string", "maxLength": 10000 }
        },
        "results": {
          "type": "object",
          "description": "Item id -> verdict for every checked item.",
          "additionalProperties": { "$ref": "#/$defs/verdict" }
        },
        "overridden": {
          "type": "object",
          "description": "Item id -> verdict set by the learner by hand (PLAY-008). Present on override attempts.",
          "additionalProperties": { "enum": ["ok", "bad"] }
        },
        "corrects": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "For an override: id of the check attempt whose verdicts it changes."
        },
        "revealed": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/localId" } },
        "complete": { "type": "boolean", "description": "True when this attempt makes the exercise done (PLAY-009)." }
      }
    }
  }
}
