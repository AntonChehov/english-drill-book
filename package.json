{
  "name": "english-drill-book",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first trainer for Russian speakers learning English from grammar workbooks",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --build",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec": "openspec validate --all --strict --no-interactive",
    "trace": "node scripts/traceability.mjs",
    "review:hash": "node scripts/review-hash.mjs",
    "audit": "pnpm audit --audit-level=high",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm spec && pnpm trace && pnpm audit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude \"**/speed.test.ts\"",
    "test:speed": "vitest run src/domain/checking/speed.test.ts --reporter=default --reporter=junit --outputFile.junit=reports/speed-junit.xml",
    "e2e": "pnpm build && playwright test --project=chromium --project=firefox --project=webkit",
    "size": "node scripts/size.mjs",
    "lhci": "lhci autorun",
    "commitlint": "commitlint --verbose",
    "verify": "pnpm check && pnpm test:coverage && pnpm test:speed && pnpm e2e && pnpm size && pnpm lhci",
    "screenshots": "playwright test --project=screenshots",
    "demo:build": "node scripts/build-demo-books.mjs && vitest run src/storage/pdf/text.test.ts --update"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@fission-ai/openspec": "1.17.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/tsconfig": "0.9.1",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "oxlint": "1.93.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
