{
  "id": "demo-drills",
  "version": "1.0.0",
  "layout": "drills",
  "title": "Everyday Grammar: Demo Drills",
  "subtitle": "Extra practice for the four units of the demo course",
  "level": "A1",
  "authors": ["English Drill Book project"],
  "edition": "1",
  "year": 2026,
  "license": "CC-BY-4.0",
  "about": [
    "This book has more exercises on the four topics of Everyday Grammar: A Demo Course. Each unit here goes with the unit of the same number in the course, which explains the rules.",
    "Do a unit of drills after the unit of the course, or come back to it a few days later to see what you remember. The answers are at the back of the book."
  ],
  "units": [
    {
      "title": "To be: am, is, are",
      "intro": "Practice for Unit 1 of the course.",
      "exercises": [
        {
          "type": "items",
          "task": "Write questions with the words.",
          "items": [
            { "prompt": "you / ready", "accept": ["Are you ready"] },
            { "prompt": "the museum / open", "accept": ["Is the museum open"] },
            { "prompt": "your parents / at home", "accept": ["Are your parents at home"] },
            { "prompt": "Nell / your sister", "accept": ["Is Nell your sister"] },
            { "prompt": "it / far from here", "accept": ["Is it far from here"] },
            { "prompt": "we / late", "accept": ["Are we late"] }
          ]
        },
        {
          "type": "items",
          "task": "Give a short answer.",
          "items": [
            { "prompt": "Are you a student? (yes)", "accept": ["Yes, I am"] },
            { "prompt": "Is Kofi at school? (no)", "accept": ["No, he isn't", "No, he's not"] },
            { "prompt": "Is the tea hot? (yes)", "accept": ["Yes, it is"] },
            {
              "prompt": "Are the children asleep? (no)",
              "accept": ["No, they aren't", "No, they're not"]
            },
            { "prompt": "Am I late? (no)", "accept": ["No, you aren't", "No, you're not"] },
            { "prompt": "Is your flat big? (yes)", "accept": ["Yes, it is"] }
          ]
        },
        {
          "type": "items",
          "task": "Choose the correct form.",
          "items": [
            {
              "prompt": "My grandparents ___ eighty years old.",
              "choices": ["is", "are"],
              "accept": ["are"]
            },
            {
              "prompt": "This bag ___ very heavy.",
              "choices": ["isn't", "aren't"],
              "accept": ["isn't"]
            },
            {
              "prompt": "I ___ good at maths.",
              "choices": ["'m not", "isn't", "aren't"],
              "accept": ["'m not"]
            },
            {
              "prompt": "Where ___ my glasses?",
              "choices": ["is", "are"],
              "accept": ["are"]
            },
            {
              "prompt": "___ your teacher from Ireland?",
              "choices": ["Is", "Are"],
              "accept": ["Is"]
            },
            {
              "prompt": "The windows ___ open, so the room is cold.",
              "choices": ["is", "are"],
              "accept": ["are"]
            }
          ]
        }
      ]
    },
    {
      "title": "Present simple: I work, she works",
      "intro": "Practice for Unit 2 of the course.",
      "exercises": [
        {
          "type": "items",
          "task": "Make the sentences negative.",
          "items": [
            { "prompt": "I drink coffee.", "accept": ["I don't drink coffee"] },
            { "prompt": "Priya lives in Oslo.", "accept": ["Priya doesn't live in Oslo"] },
            { "prompt": "We watch the news.", "accept": ["We don't watch the news"] },
            {
              "prompt": "The shop opens on Sundays.",
              "accept": ["The shop doesn't open on Sundays"]
            },
            {
              "prompt": "My brother plays the guitar.",
              "accept": ["My brother doesn't play the guitar"]
            },
            { "prompt": "They know the answer.", "accept": ["They don't know the answer"] }
          ]
        },
        {
          "type": "items",
          "task": "Write questions with the words.",
          "items": [
            { "prompt": "you / like / jazz", "accept": ["Do you like jazz"] },
            { "prompt": "Ivo / speak / Spanish", "accept": ["Does Ivo speak Spanish"] },
            {
              "prompt": "your friends / live / near you",
              "accept": ["Do your friends live near you"]
            },
            {
              "prompt": "the film / start / at eight",
              "accept": ["Does the film start at eight"]
            },
            { "prompt": "your cat / sleep / a lot", "accept": ["Does your cat sleep a lot"] },
            { "prompt": "where / you / work", "accept": ["Where do you work"] }
          ]
        },
        {
          "type": "items",
          "task": "Choose the correct form of the verb.",
          "items": [
            {
              "prompt": "My sister ___ to the radio in the car.",
              "choices": ["listen", "listens"],
              "accept": ["listens"]
            },
            {
              "prompt": "We ___ dinner at half past seven.",
              "choices": ["have", "has"],
              "accept": ["have"]
            },
            {
              "prompt": "Does Marta ___ to work?",
              "choices": ["cycle", "cycles"],
              "accept": ["cycle"]
            },
            {
              "prompt": "The museum ___ at ten in the morning.",
              "choices": ["open", "opens"],
              "accept": ["opens"]
            },
            {
              "prompt": "My parents ___ a lot of tea.",
              "choices": ["drink", "drinks"],
              "accept": ["drink"]
            },
            {
              "prompt": "Bruno ___ his homework after school.",
              "choices": ["do", "does"],
              "accept": ["does"]
            }
          ]
        }
      ]
    },
    {
      "title": "A and an",
      "intro": "Practice for Unit 3 of the course.",
      "exercises": [
        {
          "type": "items",
          "task": "Choose a or an.",
          "items": [
            {
              "prompt": "I would like ___ orange juice.",
              "choices": ["a", "an"],
              "accept": ["an"]
            },
            {
              "prompt": "There is ___ spider in the bath!",
              "choices": ["a", "an"],
              "accept": ["a"]
            },
            { "prompt": "It was ___ easy test.", "choices": ["a", "an"], "accept": ["an"] },
            {
              "prompt": "She studies at ___ university in Spain.",
              "choices": ["a", "an"],
              "accept": ["a"]
            },
            { "prompt": "We need ___ hour to cook it.", "choices": ["a", "an"], "accept": ["an"] },
            { "prompt": "He has ___ old blue car.", "choices": ["a", "an"], "accept": ["an"] }
          ]
        },
        {
          "type": "items",
          "task": "Find the mistake in each sentence. Write the correct sentence.",
          "answerLines": true,
          "items": [
            { "prompt": "She is a artist.", "accept": ["She is an artist"] },
            { "prompt": "I have an car.", "accept": ["I have a car"] },
            { "prompt": "They are an students.", "accept": ["They are students"] },
            { "prompt": "He is engineer.", "accept": ["He is an engineer"] },
            {
              "prompt": "We need a onion for the soup.",
              "accept": ["We need an onion for the soup"]
            },
            { "prompt": "It is an useful app.", "accept": ["It is a useful app"] }
          ]
        },
        {
          "type": "items",
          "task": "Answer the questions. Use a or an and the word in brackets.",
          "items": [
            { "prompt": "What is a cat? (animal)", "accept": ["(It is) an animal"] },
            { "prompt": "What is a rose? (flower)", "accept": ["(It is) a flower"] },
            { "prompt": "What is Lisbon? (city)", "accept": ["(It is) a city"] },
            { "prompt": "What is a lemon? (fruit)", "accept": ["(It is) a fruit"] },
            { "prompt": "What is an owl? (bird)", "accept": ["(It is) a bird"] },
            { "prompt": "What is Danish? (language)", "accept": ["(It is) a language"] }
          ]
        }
      ]
    },
    {
      "title": "There is and there are",
      "intro": "Practice for Unit 4 of the course.",
      "exercises": [
        {
          "type": "items",
          "task": "Write sentences with there is or there are.",
          "items": [
            { "prompt": "a cat / on the roof", "accept": ["There is a cat on the roof"] },
            { "prompt": "apples / in the bowl", "accept": ["There are (some) apples in the bowl"] },
            {
              "prompt": "a post office / in the village",
              "accept": ["There is a post office in the village"]
            },
            {
              "prompt": "books / under the bed",
              "accept": ["There are (some) books under the bed"]
            },
            { "prompt": "a message / for you", "accept": ["There is a message for you"] },
            { "prompt": "clouds / in the sky", "accept": ["There are (some) clouds in the sky"] }
          ]
        },
        {
          "type": "items",
          "task": "Choose some or any.",
          "items": [
            {
              "prompt": "There are ___ biscuits in the tin.",
              "choices": ["some", "any"],
              "accept": ["some"]
            },
            {
              "prompt": "Are there ___ buses after midnight?",
              "choices": ["some", "any"],
              "accept": ["any"]
            },
            {
              "prompt": "There aren't ___ chairs in the hall.",
              "choices": ["some", "any"],
              "accept": ["any"]
            },
            {
              "prompt": "There are ___ flowers on the table.",
              "choices": ["some", "any"],
              "accept": ["some"]
            },
            {
              "prompt": "Are there ___ good films on tonight?",
              "choices": ["some", "any"],
              "accept": ["any"]
            },
            {
              "prompt": "There aren't ___ towels in the bathroom.",
              "choices": ["some", "any"],
              "accept": ["any"]
            }
          ]
        },
        {
          "type": "items",
          "task": "Complete the conversation with there is, there are, is there or are there.",
          "items": [
            { "prompt": "A: Excuse me, ___ a chemist near here?", "accept": ["is there"] },
            {
              "prompt": "B: Yes, ___ one next to the bank.",
              "accept": ["there is / there's"]
            },
            {
              "prompt": "A: Great. And ___ any good cafes in this area?",
              "accept": ["are there"]
            },
            { "prompt": "B: Yes, ___ two on Mill Street.", "accept": ["there are"] },
            { "prompt": "A: ___ a cash machine on Mill Street too?", "accept": ["Is there"] },
            { "prompt": "B: No, ___, sorry.", "accept": ["there isn't / there's not"] }
          ]
        }
      ]
    }
  ]
}
